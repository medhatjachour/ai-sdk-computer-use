# Required for Claude AI responses
GROQ_API_KEY= needed

# Required for desktop sandbox
SANDBOX_SNAPSHOT_ID= needed

# Required for @vercel/sandbox authentication
# Get your token from: https://vercel.com/account/tokens
VERCEL_TOKEN= needed

# Fix for Windows: xdg-app-paths (used by @vercel/sandbox) needs HOME defined
# Use forward slashes — backslashes are escape chars in .env files
HOME=C:/Users/{user}
